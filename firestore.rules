rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId); // no client code reads other users' profile docs directly
      allow list: if false; // Profiles shouldn't be listed normally
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Check-ins
    match /checkins/{userId} {
      function isValidCheckIn() {
        let d = request.resource.data;
        return d.userId == userId
          && d.keys().hasOnly([
            'userId', 'placeId', 'placeName', 'location', 'checkInAt', 'expiresAt',
            'userName', 'userPhoto', 'userStyle', 'userTags', 'userField', 'userBio', 'isCustomLocation'
          ])
          && d.expiresAt is timestamp
          && d.expiresAt <= request.time + duration.value(65, 'm'); // 1h TTL + buffer, blocks permanent check-ins
      }
      allow read: if isSignedIn();
      allow list: if isSignedIn(); // Crucial for "who is in this cafe"
      allow create: if isOwner(userId) && isValidCheckIn();
      allow update: if isOwner(userId) && isValidCheckIn();
      allow delete: if isOwner(userId);
    }

    // Chat Requests
    match /chat_requests/{requestId} {
      function isParty() {
        return request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      }
      allow read: if isSignedIn() && isParty();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && isParty();
      allow delete: if false;
    }

    // Chats
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      allow read, update: if isParticipant();
      allow create: if isSignedIn();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Events (화면 이름 "번개") — 장소에서 "지금" 여는 만남.
    // 열기·참가는 그 장소에 체크인한 사람만. 장소와 시각은 생성 후 변경 불가.
    // 종료 ≤ 25시간 뒤로 제한 → endAt TTL로 Google 좌표·장소명이 하루 안에 지워짐.
    match /events/{eventId} {
      function checkinPath() {
        return /databases/$(database)/documents/checkins/$(request.auth.uid);
      }
      function isCheckedInAt(placeId) {
        return exists(checkinPath())
          && get(checkinPath()).data.placeId == placeId
          && get(checkinPath()).data.expiresAt > request.time;
      }
      // Non-creators may only add/remove themselves from the attendee list, never another uid
      function selfOnlyAttendeeChange() {
        let added = request.resource.data.attendees.removeAll(resource.data.attendees);
        let removed = resource.data.attendees.removeAll(request.resource.data.attendees);
        return added.hasOnly([request.auth.uid]) && removed.hasOnly([request.auth.uid]);
      }
      function isJoining() {
        return request.resource.data.attendees.removeAll(resource.data.attendees).size() > 0;
      }
      function validText(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.description is string && d.description.size() <= 500;
      }
      function isValidNewBolt() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'creatorId', 'creatorName', 'creatorPhoto', 'title', 'description', 'location', 'locationName',
            'placeId', 'radiusKm', 'startAt', 'endAt', 'attendees', 'attendeeNames', 'attendeePhotos', 'createdAt'
          ])
          && d.creatorId == request.auth.uid
          && d.placeId is string && d.placeId.size() > 0 && d.placeId.size() <= 256
          && validText(d)
          && d.locationName is string && d.locationName.size() <= 100
          && d.location.lat is number && d.location.lng is number
          && d.endAt is timestamp && d.endAt > request.time
          && d.endAt <= request.time + duration.value(25, 'h')
          && d.attendees == [request.auth.uid]
          && isCheckedInAt(d.placeId);
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNewBolt();
      allow update: if isSignedIn() && (
        (resource.data.creatorId == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'description'])
          && validText(request.resource.data))
        || (request.resource.data.diff(resource.data).affectedKeys()
              .hasOnly(['attendees', 'attendeeNames', 'attendeePhotos', 'attendeeCount'])
            && selfOnlyAttendeeChange()
            && (!isJoining() || (resource.data.endAt > request.time && isCheckedInAt(resource.data.placeId))))
      );
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Open Chat Rooms — ID format: {placeId}_{userId}, one room per user per place
    match /openRooms/{roomId} {
      allow read: if isSignedIn();
      // Only the creator can create their own room (roomId must end with their uid)
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && roomId == (request.resource.data.placeId + '_' + request.auth.uid);
      // Members can update membership/last-message fields; never another uid's membership
      function selfOnlyMemberChange() {
        let added = request.resource.data.members.removeAll(resource.data.members);
        let removed = resource.data.members.removeAll(request.resource.data.members);
        return added.hasOnly([request.auth.uid]) && removed.hasOnly([request.auth.uid]);
      }
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberNames', 'memberPhotos', 'memberCount', 'lastMessage', 'lastMessageAt'])
        && selfOnlyMemberChange();
      // Creator can always delete; last remaining member can delete to clean up empty room
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.members.size() == 1 && request.auth.uid in resource.data.members)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/openRooms/$(roomId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/openRooms/$(roomId)).data.members
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Place Stats (event history aggregation) — placeId + 집계값만 (장소명/좌표 저장 금지)
    // +1은 "같은 batch에서 내가 이 장소에 새 이벤트를 만들 때"만 허용 → 이벤트 없이 카운트 조작 불가
    match /placeStats/{placeId} {
      function newEventPath() {
        return /databases/$(database)/documents/events/$(request.resource.data.lastEventId);
      }
      function isCountingNewEvent() {
        return !exists(newEventPath())
          && existsAfter(newEventPath())
          && getAfter(newEventPath()).data.placeId == placeId
          && getAfter(newEventPath()).data.creatorId == request.auth.uid
          && request.resource.data.lastEventAt == request.time;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.keys().hasOnly(['placeId', 'totalEvents', 'lastEventAt', 'lastEventId'])
        && request.resource.data.placeId == placeId
        && request.resource.data.totalEvents == 1
        && isCountingNewEvent();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['totalEvents', 'lastEventAt', 'lastEventId'])
        && request.resource.data.totalEvents == resource.data.totalEvents + 1
        && isCountingNewEvent();
      allow delete: if false;
    }

    // Meetups — participantIds는 신청 순서. 앞 capacity명 = 확정, 나머지 = 대기열.
    // 기간 제한은 Google 좌표 30일 캐시 제한 때문 (src/lib/firebase/meetups.ts와 같은 값):
    //   startAt ≤ 생성+28일, 진행 ≤ 12시간, purgeAt(TTL) ≤ 생성+29일. 장소/일시는 생성 후 변경 불가.
    match /meetups/{meetupId} {
      function validContent(d) {
        return d.title is string && d.title.size() > 0 && d.title.size() <= 60
          && d.description is string && d.description.size() <= 1000
          && d.capacity is int && d.capacity >= 2 && d.capacity <= 50
          && d.participantIds.size() <= 100;
      }
      // after = before에서 일부만 빠진 것 (추가·순서 변경 없음)
      function onlyRemoved(before, after) {
        return before.removeAll(before.removeAll(after)) == after;
      }
      // 내 uid 하나가 끝에 붙은 것
      function selfAppended(before, after) {
        return !(request.auth.uid in before)
          && after.size() == before.size() + 1
          && after[0:before.size()] == before
          && after[before.size()] == request.auth.uid;
      }
      function selfRemoved(before, after) {
        return onlyRemoved(before, after) && before.removeAll(after) == [request.auth.uid];
      }
      function isHostUpdate() {
        let d = request.resource.data;
        let r = resource.data;
        return r.hostId == request.auth.uid
          && d.diff(r).affectedKeys().hasOnly(['title', 'description', 'capacity', 'status', 'participantIds', 'participants'])
          && validContent(d)
          && d.status in ['open', 'cancelled']
          // capacity ≥ min(현재 인원, 기존 capacity) = 확정 인원 아래로 못 줄임
          && (d.capacity >= r.participantIds.size() || d.capacity >= r.capacity)
          && onlyRemoved(r.participantIds, d.participantIds)
          && d.participants.diff(r.participants).addedKeys().size() == 0
          && d.participants.diff(r.participants).changedKeys().size() == 0;
      }
      function isParticipantUpdate() {
        let d = request.resource.data;
        let r = resource.data;
        return d.diff(r).affectedKeys().hasOnly(['participantIds', 'participants'])
          && d.participants.diff(r.participants).affectedKeys().hasOnly([request.auth.uid])
          && d.participantIds.size() <= 100
          && (
            (r.status == 'open' && r.startAt > request.time && selfAppended(r.participantIds, d.participantIds))
            || selfRemoved(r.participantIds, d.participantIds)
          );
      }
      function isValidNewMeetup() {
        let d = request.resource.data;
        return d.keys().hasOnly([
            'hostId', 'hostName', 'hostPhoto', 'placeId', 'placeName', 'location', 'category',
            'title', 'description', 'startAt', 'endAt', 'capacity', 'participantIds', 'participants',
            'status', 'createdAt', 'purgeAt'
          ])
          && d.hostId == request.auth.uid
          && d.participantIds == [request.auth.uid]
          && d.participants.keys().hasOnly([request.auth.uid])
          && d.status == 'open'
          && d.category in ['reading', 'study', 'sports', 'boardgame', 'language', 'etc']
          && validContent(d)
          && d.placeId is string && d.placeId.size() > 0 && d.placeId.size() <= 256
          && d.placeName is string && d.placeName.size() > 0 && d.placeName.size() <= 100
          && d.location.lat is number && d.location.lng is number
          && d.startAt is timestamp && d.startAt > request.time
          && d.startAt <= request.time + duration.value(28, 'd')
          && d.endAt is timestamp && d.endAt > d.startAt
          && d.endAt <= d.startAt + duration.value(12, 'h')
          && d.purgeAt is timestamp && d.purgeAt > d.endAt
          && d.purgeAt <= request.time + duration.value(29, 'd')
          && d.createdAt == request.time;
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && isValidNewMeetup();
      allow update: if isSignedIn() && (isHostUpdate() || isParticipantUpdate());
      allow delete: if isSignedIn() && resource.data.hostId == request.auth.uid;
    }

    // Marks (personal location diary, optionally shared)
    match /marks/{markId} {
      function isCreator() {
        return isSignedIn() && resource.data.creatorId == request.auth.uid;
      }
      function isSharedWithMe() {
        return isSignedIn() && request.auth.uid in resource.data.sharedWith;
      }
      allow read: if isCreator() || isSharedWithMe();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isCreator();
      allow delete: if isCreator();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      // Reviews (isReview == true) are public; private feedback is restricted to parties.
      allow read: if isSignedIn() && (
        resource.data.isReview == true ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}
