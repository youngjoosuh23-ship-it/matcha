rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isOwner(userId); // no client code reads other users' profile docs directly
      allow list: if false; // Profiles shouldn't be listed normally
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Check-ins
    match /checkins/{userId} {
      function isValidCheckIn() {
        let d = request.resource.data;
        return d.userId == userId
          && d.keys().hasOnly([
            'userId', 'placeId', 'placeName', 'location', 'checkInAt', 'expiresAt',
            'userName', 'userPhoto', 'userStyle', 'userTags', 'userField', 'userBio', 'isCustomLocation'
          ])
          && d.expiresAt is timestamp
          && d.expiresAt <= request.time + duration.value(65, 'm'); // 1h TTL + buffer, blocks permanent check-ins
      }
      allow read: if isSignedIn();
      allow list: if isSignedIn(); // Crucial for "who is in this cafe"
      allow create: if isOwner(userId) && isValidCheckIn();
      allow update: if isOwner(userId) && isValidCheckIn();
      allow delete: if isOwner(userId);
    }

    // Chat Requests
    match /chat_requests/{requestId} {
      function isParty() {
        return request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      }
      allow read: if isSignedIn() && isParty();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && isParty();
      allow delete: if false;
    }

    // Chats
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      allow read, update: if isParticipant();
      allow create: if isSignedIn();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Events
    match /events/{eventId} {
      // Non-creators may only add/remove themselves from the attendee list, never another uid
      function selfOnlyAttendeeChange() {
        let added = request.resource.data.attendees.removeAll(resource.data.attendees);
        let removed = resource.data.attendees.removeAll(request.resource.data.attendees);
        return added.hasOnly([request.auth.uid]) && removed.hasOnly([request.auth.uid]);
      }
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      // Creator can update any field; others can only join/leave (their own uid only)
      allow update: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['attendees', 'attendeeNames', 'attendeePhotos', 'attendeeCount'])
          && selfOnlyAttendeeChange())
      );
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Open Chat Rooms — ID format: {placeId}_{userId}, one room per user per place
    match /openRooms/{roomId} {
      allow read: if isSignedIn();
      // Only the creator can create their own room (roomId must end with their uid)
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && roomId == (request.resource.data.placeId + '_' + request.auth.uid);
      // Members can update membership/last-message fields; never another uid's membership
      function selfOnlyMemberChange() {
        let added = request.resource.data.members.removeAll(resource.data.members);
        let removed = resource.data.members.removeAll(request.resource.data.members);
        return added.hasOnly([request.auth.uid]) && removed.hasOnly([request.auth.uid]);
      }
      allow update: if isSignedIn()
        && (request.auth.uid in resource.data.members || request.auth.uid in request.resource.data.members)
        && request.resource.data.diff(resource.data).affectedKeys()
          .hasOnly(['members', 'memberNames', 'memberPhotos', 'memberCount', 'lastMessage', 'lastMessageAt'])
        && selfOnlyMemberChange();
      // Creator can always delete; last remaining member can delete to clean up empty room
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.members.size() == 1 && request.auth.uid in resource.data.members)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/openRooms/$(roomId)).data.members;
        allow create: if isSignedIn()
          && request.auth.uid in get(/databases/$(database)/documents/openRooms/$(roomId)).data.members
          && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Place Stats (event history aggregation)
    match /placeStats/{placeId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn();
      allow delete: if false;
    }

    // Marks (personal location diary, optionally shared)
    match /marks/{markId} {
      function isCreator() {
        return isSignedIn() && resource.data.creatorId == request.auth.uid;
      }
      function isSharedWithMe() {
        return isSignedIn() && request.auth.uid in resource.data.sharedWith;
      }
      allow read: if isCreator() || isSharedWithMe();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isCreator();
      allow delete: if isCreator();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      // Reviews (isReview == true) are public; private feedback is restricted to parties.
      allow read: if isSignedIn() && (
        resource.data.isReview == true ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}
