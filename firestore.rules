rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    function isValidId(id) {
      return id is string && id.size() <= 128;
    }

    // Default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User Profiles
    match /users/{userId} {
      allow get: if isSignedIn();
      allow list: if false; // Profiles shouldn't be listed normally
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if false;
    }

    // Check-ins
    match /checkins/{userId} {
      allow read: if isSignedIn();
      allow list: if isSignedIn(); // Crucial for "who is in this cafe"
      allow create: if isOwner(userId);
      allow update: if isOwner(userId);
      allow delete: if isOwner(userId);
    }

    // Chat Requests
    match /chat_requests/{requestId} {
      function isParty() {
        return request.auth.uid == resource.data.fromUserId || request.auth.uid == resource.data.toUserId;
      }
      allow read: if isSignedIn() && isParty();
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      allow update: if isSignedIn() && isParty();
      allow delete: if false;
    }

    // Chats
    match /chats/{chatId} {
      function isParticipant() {
        return isSignedIn() && request.auth.uid in resource.data.participants;
      }
      allow read, update: if isParticipant();
      allow create: if isSignedIn();
      allow delete: if false;

      // Messages subcollection
      match /messages/{messageId} {
        allow read: if isSignedIn() && request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Events
    match /events/{eventId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if isSignedIn() && resource.data.creatorId == request.auth.uid;
    }

    // Open Chat Rooms — ID format: {placeId}_{userId}, one room per user per place
    match /openRooms/{roomId} {
      allow read: if isSignedIn();
      // Only the creator can create their own room (roomId must end with their uid)
      allow create: if isSignedIn()
        && request.resource.data.creatorId == request.auth.uid
        && roomId == (request.resource.data.placeId + '_' + request.auth.uid);
      // Any signed-in user can update (join/leave/send last message preview)
      allow update: if isSignedIn();
      // Creator can always delete; last remaining member can delete to clean up empty room
      allow delete: if isSignedIn() && (
        resource.data.creatorId == request.auth.uid ||
        (resource.data.members.size() == 1 && request.auth.uid in resource.data.members)
      );

      match /messages/{messageId} {
        allow read: if isSignedIn();
        allow create: if isSignedIn() && request.resource.data.senderId == request.auth.uid;
        allow update, delete: if false;
      }
    }

    // Place Stats (event history aggregation)
    match /placeStats/{placeId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn(); // written by createEvent on the client
    }

    // Marks (personal location diary, optionally shared)
    match /marks/{markId} {
      function isCreator() {
        return isSignedIn() && resource.data.creatorId == request.auth.uid;
      }
      function isSharedWithMe() {
        return isSignedIn() && request.auth.uid in resource.data.sharedWith;
      }
      allow read: if isCreator() || isSharedWithMe();
      allow create: if isSignedIn() && request.resource.data.creatorId == request.auth.uid;
      allow update: if isCreator();
      allow delete: if isCreator();
    }

    // Feedback
    match /feedback/{feedbackId} {
      allow create: if isSignedIn() && request.resource.data.fromUserId == request.auth.uid;
      // Reviews (isReview == true) are public; private feedback is restricted to parties.
      allow read: if isSignedIn() && (
        resource.data.isReview == true ||
        resource.data.fromUserId == request.auth.uid ||
        resource.data.toUserId == request.auth.uid
      );
      allow update, delete: if false;
    }
  }
}
