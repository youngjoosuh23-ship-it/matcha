{
  "firestore": [
    {
      "database": "ai-studio-83469dda-d152-4d67-83ea-b50033ec8101",
      "rules": "firestore.rules"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "functions": [
    {
      "source": "functions",
      "codebase": "default",
      "ignore": ["node_modules", ".git", "firebase-debug.log", "firebase-debug.*.log"]
    }
  ],
  "hosting": {
    "public": "dist",
    "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
    "rewrites": [
      { "source": "/tourapi/**", "function": "tourApiProxy" },
      { "source": "/cultureapi/**", "function": "cultureApiProxy" },
      { "source": "/fstvlapi/**", "function": "fstvlApiProxy" },
      { "source": "/overpass", "function": "overpassProxy" },
      { "source": "**", "destination": "/index.html" }
    ]
  }
}
