# GOOGLE_MAPS_PLATFORM_KEY: Required for Google Maps features.
# Get an API key from https://console.cloud.google.com/google/maps-apis/start
GOOGLE_MAPS_PLATFORM_KEY="MY_GOOGLE_MAPS_KEY"

# GOOGLE_MAP_ID: Google Cloud Console에서 만든 지도 ID (지도 스타일 연결: POI 숨김, 무채색).
# 비워 두면 Google 기본 지도 스타일로 표시됩니다.
GOOGLE_MAP_ID=""
